<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <input>
        <net-file value="a.net.xml"/>
        <route-files value="a.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="10000"/>
    </time>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>

    <gui_only>
        <gui-settings-file value="a.view.xml"/>
    </gui_only>

</configuration>
